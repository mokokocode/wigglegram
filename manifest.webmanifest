{
  "name": "Wigglegram Bench",
  "short_name": "Wigglegram",
  "description": "Align, crop and export wigglegrams from the Nishika N8000 and other multi-lens cameras. Works offline; nothing leaves your device.",
  "start_url": "./",
  "scope": "./",
  "id": "wigglegram-bench",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#FBFBF9",
  "theme_color": "#FDC800",
  "categories": ["photo", "graphics", "utilities"],
  "icons": [
    { "src": "./icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "frames", "accept": ["image/jpeg", "image/png", "image/webp"] }
      ]
    }
  }
}
